<header
  id="smart-navbar"
  class="fixed top-0 z-50 w-full pt-4 sm:pt-8 transition-transform duration-300"
>
  <nav
    class="mx-auto flex w-full sm:w-max items-center justify-center gap-3 sm:gap-8 px-2 sm:px-0 text-[12px] sm:text-sm font-semibold tracking-wide"
  >
    <a
      href="#proyectos"
      class="transition-all hover:-translate-y-1 hover:text-rose-700"
      >Proyectos</a
    >

    <a
      href="#sobre-mi"
      class="whitespace-nowrap transition-all hover:-translate-y-1 hover:text-rose-700"
      >Sobre Mí</a
    >

    <a
      href="#stack"
      class="transition-all hover:-translate-y-1 hover:text-rose-700"
      >Stack</a
    >

    <a
      href="mailto:cristophercerritos0@gmail.com"
      class="transition-all hover:-translate-y-1 hover:text-rose-700"
      >Contacto</a
    >

  </nav>
</header>

<script>
  // Guardamos la última posición del scroll
  let lastScrollY = window.scrollY;
  // Seleccionamos el header por su ID
  const navbar = document.getElementById("smart-navbar");

  window.addEventListener("scroll", () => {
    // Verificamos que el navbar exista para evitar errores
    if (!navbar) return;

    // Posición actual del scroll
    const currentScrollY = window.scrollY;

    // Si bajamos (currentScrollY > lastScrollY) y hemos bajado más de 50px
    if (currentScrollY > lastScrollY && currentScrollY > 50) {
      // Escondemos el navbar moviéndolo hacia arriba fuera de la pantalla
      navbar.classList.add("-translate-y-full");
    } else {
      // Si subimos, lo volvemos a mostrar quitando la clase
      navbar.classList.remove("-translate-y-full");
    }

    // Actualizamos la última posición
    lastScrollY = currentScrollY;
  });
</script>
