---
// BentoGrid.astro

import GitHubIcon from "../components/icons/GitHub.astro";
import ExternalLink from "./icons/ExternalLink.astro";
import NextJS from "./icons/NextJS.astro";
import Tailwind from "./icons/Tailwind.astro";

// Diccionario de tecnologías disponibles
const TAGS: Record<string, { name: string; class: string; icon: any }> = {
  NEXT: {
    name: "Next.js",
    class: "bg-black text-white",
    icon: NextJS,
  },
  TAILWIND: {
    name: "Tailwind CSS",
    class: "bg-[#003159] text-white",
    icon: Tailwind,
  },
  ASTRO: {
    name: "Astro",
    class: "bg-[#28203e] text-white",
    icon: Astro,
  },
};

const proyectos = [
  {
    titulo: "Michells Beauty Salon",
    desc: "Sitio web de una salon de belleza",
    size: "col-span-3 row-span-2",
    logo: "/michells.jpg",
    screenshot: "/mcihells2.png",
    github: "https://github.com/crisce-03/Michells-Beauty-Salon",
    demo: "https://michells-beauty-salon.vercel.app/",
    tags: [TAGS.NEXT],
  },
  {
    titulo: "Proyecto 2",
    desc: "Descripción",
    size: "col-span-3 row-span-2",
    logo: "/logos/proyecto2.png",
    screenshot: "/screenshots/proyecto2.png",
    github: "https://github.com/tuusuario/proyecto2",
    demo: "https://proyecto2.com",
    tags: [TAGS.NEXT, TAGS.TAILWIND],
  },
  {
    titulo: "Proyecto 3",
    desc: "Descripción",
    size: "col-span-2 row-span-2",
    logo: "/logos/proyecto3.png",
    screenshot: "/screenshots/proyecto3.png",
    github: "https://github.com/tuusuario/proyecto3",
    demo: "https://proyecto3.com",
    tags: [TAGS.NEXT, TAGS.TAILWIND],
  },
  {
    titulo: "Proyecto 4",
    desc: "Descripción",
    size: "col-span-2 row-span-2",
    logo: "/logos/proyecto4.png",
    screenshot: "/screenshots/proyecto4.png",
    github: "https://github.com/tuusuario/proyecto4",
    demo: "https://proyecto4.com",
    tags: [TAGS.NEXT, TAGS.TAILWIND],
  },
  {
    titulo: "Proyecto 5",
    desc: "Descripción",
    size: "col-span-2 row-span-2",
    logo: "/logos/proyecto5.png",
    screenshot: "/screenshots/proyecto5.png",
    github: "https://github.com/tuusuario/proyecto5",
    demo: "https://proyecto5.com",
    tags: [TAGS.NEXT, TAGS.TAILWIND],
  },
];
---

<div class="grid grid-cols-1 lg:grid-cols-6 auto-rows-[200px] gap-4 p-6">
  {proyectos.map((p) => (
    <div class={`${p.size} group relative overflow-hidden rounded-2xl border border-white/10 bg-neutral-900 transition-all duration-300 hover:border-rose-800/50 hover:shadow-[0_0_30px_-5px_rgba(136,19,55,0.4)]`}>

      <img
        src={p.logo}
        alt={`${p.titulo} logo`}
        class="absolute inset-0 h-full w-full object-contain p-10 opacity-90 transition-opacity duration-300 group-hover:opacity-0"
      />

      <img
        src={p.screenshot}
        alt={`${p.titulo} preview`}
        class="absolute inset-0 h-full w-full object-cover opacity-0 scale-105 transition-all duration-500 group-hover:opacity-100 group-hover:scale-100"
      />

      <div class="absolute inset-0 bg-gradient-to-t from-black/90 via-black/40 to-black/10 opacity-0 transition-opacity duration-300 group-hover:opacity-100"></div>

      <div class="relative z-10 flex h-full flex-col justify-end p-5">
        <h3 class="text-lg font-semibold text-white opacity-0 translate-y-2 transition-all duration-300 group-hover:opacity-100 group-hover:translate-y-0">
          {p.titulo}
        </h3>
        <p class="text-sm text-neutral-300 opacity-0 translate-y-2 transition-all duration-300 delay-75 group-hover:opacity-100 group-hover:translate-y-0">
          {p.desc}
        </p>

        <ul class="flex flex-row flex-wrap mt-3 gap-2 opacity-0 translate-y-2 transition-all duration-300 delay-100 group-hover:opacity-100 group-hover:translate-y-0">
          {p.tags.map((tag) => (
            <li>
              <span class={`flex items-center gap-x-1.5 rounded-full text-xs ${tag.class} py-1 px-2`}>
                <tag.icon class="size-4" />
                {tag.name}
              </span>
            </li>
          ))}
        </ul>

        <div class="mt-3 flex gap-3 opacity-0 translate-y-2 transition-all duration-300 delay-150 group-hover:opacity-100 group-hover:translate-y-0">
          <a
            class="text-on-tertiary-container hover:text-rose-800/60 transition-all hover:scale-125"
            href={p.github}
            target="_blank"
            rel="noopener noreferrer"
          >
            <GitHubIcon class="size-6" />
          </a>

          <a
            class="text-on-tertiary-container hover:text-rose-800/60 transition-all hover:scale-125"
            href={p.demo}
            target="_blank"
            rel="noopener noreferrer"
          >
            <ExternalLink class="size-6" />
          </a>
        </div>
      </div>
    </div>
  ))}
</div>