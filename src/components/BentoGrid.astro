---
import GitHubIcon from "../components/icons/GitHub.astro";
import ExternalLink from "./icons/ExternalLink.astro";
import NextJS from "./icons/NextJS.astro";
import Tailwind from "./icons/Tailwind.astro";
import AstroIcon from "./icons/AstroIcon.astro";
import React from "./icons/React.astro";
import CSharp from "./icons/CSharp.astro";
import Java from "./icons/Java.astro";

const TAGS: Record<string, { name: string; class: string; icon: any }> = {
  NEXT: {
    name: "Next.js",
    class: "bg-black text-white",
    icon: NextJS,
  },
  TAILWIND: {
    name: "Tailwind CSS",
    class: "bg-[#003159] text-white",
    icon: Tailwind,
  },
  ASTRO: {
    name: "Astro",
    class: "bg-[#28203e] text-white",
    icon: AstroIcon,
  },
  REACT: {
    name: "React",
    class: "bg-[#23272f] text-white",
    icon: React,
  },
  CSHARP: {
    name: "C#",
    class: "bg-[#280068] text-white",
    icon: CSharp,
  },
  JAVA: {
    name: "Java",
    class: "bg-[#1c2834] text-white",
    icon: Java,
  },
};

const proyectos = [
  {
    titulo: "FacturitoSV",
    desc: "Facturación electrónica para PYME's en El Salvador",
    size: "col-span-1 lg:col-span-6 row-span-1 lg:row-span-2", 
    logo: "/facturitoSV.jpg",
    screenshot: "/facturitoSV.jpg",
    github: "https://github.com/facturito-SV",
    demo: "https://facturitosv.lat",
    tags: [TAGS.REACT,TAGS.CSHARP],
  },
  {
    titulo: "Michells Beauty Salon",
    desc: "Sitio web de un salón de belleza",
    size: "col-span-1 lg:col-span-3 row-span-1 lg:row-span-2", 
    logo: "/michells.jpg",
    screenshot: "/mcihells2.png",
    github: "https://github.com/crisce-03/Michells-Beauty-Salon",
    demo: "https://michells-beauty-salon.vercel.app/",
    tags: [TAGS.NEXT],
  },
  {
    titulo: "SIGVET",
    desc: "Sistema de gestión de ventas",
    size: "col-span-1 lg:col-span-3 row-span-1 lg:row-span-2", 
    logo: "/sigvetLogo.png",
    screenshot: "/sigvetLogo.png",
    github: "https://github.com/crisce-03/SIGVET",
    demo: "https://github.com/crisce-03/SIGVET",
    tags: [TAGS.JAVA],
  }
];
---

<div class="grid grid-cols-1 lg:grid-cols-6 auto-rows-[250px] lg:auto-rows-[200px] gap-4 p-6">
  {proyectos.map((p) => (
    <div class={`${p.size} group relative overflow-hidden rounded-2xl border border-black/10 bg-neutral-900 transition-all duration-300 hover:border-rose-800/50 hover:shadow-[0_0_30px_-5px_rgba(136,19,55,0.4)]`}>

      
      <img
        src={p.logo}
        alt={`${p.titulo} logo`}
        class="absolute inset-0 h-full w-full object-cover   opacity-100 transition-opacity duration-300 lg:opacity-60 lg:group-hover:opacity-0"
      />

     
      <img
        src={p.screenshot}
        alt={`${p.titulo} preview`}
        class="absolute inset-0 h-full w-full object-cover opacity-0 scale-100 transition-all duration-500 lg:scale-105 lg:group-hover:opacity-100 lg:group-hover:scale-100"
      />

   
      <div class="absolute inset-0 bg-gradient-to-t from-black/90 via-black/60 to-transparent opacity-100 transition-opacity duration-300 lg:opacity-0 lg:group-hover:opacity-100"></div>

      <div class="relative z-10 flex h-full flex-col justify-end p-5">
        
 
        <h3 class="text-lg font-semibold text-white opacity-100 translate-y-0 transition-all duration-300 lg:opacity-0 lg:translate-y-2 lg:group-hover:opacity-100 lg:group-hover:translate-y-0">
          {p.titulo}
        </h3>
        

        <p class="text-sm text-neutral-300 opacity-100 translate-y-0 transition-all duration-300 lg:delay-75 lg:opacity-0 lg:translate-y-2 lg:group-hover:opacity-100 lg:group-hover:translate-y-0">
          {p.desc}
        </p>


        <ul class="flex flex-row flex-wrap mt-3 gap-2 opacity-100 translate-y-0 transition-all duration-300 lg:delay-100 lg:opacity-0 lg:translate-y-2 lg:group-hover:opacity-100 lg:group-hover:translate-y-0">
          {p.tags.map((tag) => (
            <li>
              <span class={`flex items-center gap-x-1.5 rounded-full text-xs ${tag.class} py-1 px-2`}>
                <tag.icon class="size-4" />
                {tag.name}
              </span>
            </li>
          ))}
        </ul>


        <div class="mt-3 flex gap-3 opacity-100 translate-y-0 transition-all duration-300 lg:delay-150 lg:opacity-0 lg:translate-y-2 lg:group-hover:opacity-100 lg:group-hover:translate-y-0">
          <a
            class="text-neutral-300 hover:text-rose-500 transition-all hover:scale-125"
            href={p.github}
            target="_blank"
            rel="noopener noreferrer"
            aria-label={`Ver código fuente de ${p.titulo}`}
          >
            <GitHubIcon class="size-6" />
          </a>

          <a
            class="text-neutral-300 hover:text-rose-500 transition-all hover:scale-125"
            href={p.demo}
            target="_blank"
            rel="noopener noreferrer"
            aria-label={`Ver demo en vivo de ${p.titulo}`}
          >
            <ExternalLink class="size-6" />
          </a>
        </div>
      </div>
    </div>
  ))}
</div>