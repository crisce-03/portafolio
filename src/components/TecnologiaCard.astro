---
const Name = Astro.props.name;
const Icon = Astro.props.icon;
---


<div class="group relative flex flex-col items-center justify-center w-max">
    

    <div class="flex items-center justify-center size-12 transition-transform duration-300 group-hover:scale-110 [&>svg]:w-full [&>svg]:h-full">
        <Icon />
    </div>

    <div class="absolute top-4 z-10 rounded-md bg-neutral-800 px-2 py-1 text-xs text-white opacity-0 transition-all duration-300 pointer-events-none whitespace-nowrap group-hover:-top-8 group-hover:opacity-100 dark:bg-neutral-200 dark:text-black">
        {Name}
    </div>
    
</div>