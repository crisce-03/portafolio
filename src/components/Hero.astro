---
import GitHubIcon from "../components/icons/GitHub.astro";
import InstagramIcon from "../components/icons/Instagram.astro";
import LinkedInIcon from "../components/icons/LinkedIn.astro";
import MailIcon from "../components/icons/Mail.astro";
---

<div
  class="flex flex-col-reverse lg:flex-row items-center justify-between gap-12 max-w-6xl mx-auto px-6 py-20"
>
  <div class="flex-1 text-center lg:text-left">
    <h1
      class="anim-fade-in anim-delay-1 text-4xl lg:text-4xl font-bold tracking-tight text-gray-800 dark:text-white"
    >
      Hola, soy

      <span
        class="bg-gradient-to-r from-rose-500 via-rose-600 to-rose-700 bg-clip-text text-transparent"
      >
      <br>
        Cristopher Cerritos</span
      >
    </h1>

    <p
      class="anim-fade-in anim-delay-2 mt-6 text-lg lg:text-xl text-gray-800 dark:text-gray-300"
    >
      
        Soy Desarrollador Web. Más que escribir código,
        me enfoco en diseñar soluciones eficientes aplicando las
        mejores arquitecturas de software y patrones de diseño, siempre profundizando en nuevas tecnologías.
      
      
    </p>

    <nav
      class="anim-fade-in anim-delay-3 flex flex-wrap justify-center items-center lg:justify-start gap-4 mt-8"
    >
      <a
        class="text-neutral-400 hover:text-rose-500 transition-all hover:scale-125"
        href="https://www.instagram.com/crisce_03/"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Instagram de Cristopher Cerritos"
      >
        <InstagramIcon class="size-8" />
      </a>
      <a
        class="text-neutral-400 hover:text-rose-500 transition-all hover:scale-125"
        href="https://www.linkedin.com/in/cristopher-cerritos-a47a06355/"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="LinkedIn de Cristopher Cerritos"
      >
        <LinkedInIcon class="size-7" />
      </a>
      <a
        class="text-neutral-400 hover:text-rose-500 transition-all hover:scale-125"
        href="https://github.com/crisce-03"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="GitHub de Cristopher Cerritos"
      >
        <GitHubIcon class="size-7" />
      </a>
      <a
        class="text-neutral-400 hover:text-rose-500 transition-all hover:scale-125"
        href="mailto:cristophercerritos0@gmail.com"
        aria-label="Enviar correo a Cristopher Cerritos"
      >
        <MailIcon class="size-8" />
      </a>
    </nav>


    <div class="anim-fade-in anim-delay-4 mt-8 flex flex-wrap justify-center lg:justify-start gap-4">
      <a 
        href="/Cristopher_Cerritos_CV.pdf" 
        target="_blank"
        rel="noopener noreferrer"
        class="px-6 py-3 text-sm font-bold rounded-full bg-gradient-to-r from-rose-500 via-rose-600 to-rose-700 text-white transition-transform hover:scale-105"
      >
        Descargar CV
      </a>
    </div>

    
  </div>

  <!-- Imagen -->
  <div class="flex-1 flex justify-center">
    <img
      class="w-72 h-72 lg:w-96 lg:h-96 object-cover object-[center_25%] rounded-full shadow-2xl"
      src="/yo2.jpg"
      alt="Cristopher Cerritos"
      width={384}
      height={384}
      loading="eager"
    />
  </div>
  

  
</div>
