---
import "@fontsource-variable/onest";
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { ClientRouter } from "astro:transitions";

interface Props {
  title: string;
  description: string;
  image?: string;
  canonical?: string;
}

const {
  description,
  title,
  image = "/devPhoto.jpeg",
  canonical = Astro.url.href,
} = Astro.props;

const siteUrl = "https://cristophercerritosdev.lat";
const ogImage = new URL(image, siteUrl).toString();

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: "Cristopher Cerritos",
  url: siteUrl,
  sameAs: [
    "https://linkedin.com/in/cristopher-cerritos",
    "https://github.com/crisce-03",
  ],
  jobTitle: "Desarrollador Web Full Stack",
  worksFor: {
    "@type": "Organization",
    name: "Freelance",
  },
};
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="author" content="Cristopher Cerritos" />
    <meta name="generator" content={Astro.generator} />

    <link rel="canonical" href={canonical} />

    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content="es_ES" />
    <meta property="og:site_name" content="Cristopher Cerritos · Portfolio" />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

    <link rel="icon" type="image/png" href="/devIcon2.png" />
    <title>{title}</title>
    <meta name="darkreader-lock" />
    <ClientRouter />
  </head>

  <body class="relative text-neutral-900">
    <div
      class="fixed top-0 z-[-2] h-screen w-screen bg-white bg-[radial-gradient(ellipse_80%_80%_at_50%_-20%,rgba(225,29,72,0.12),rgba(255,255,255,0))]"
    >
    </div>


    <div
      class="pointer-events-none fixed inset-0 z-[-1] opacity-[0.035]"
      style="background-image: url('/noise.svg'); background-size: 200px 200px;"
      aria-hidden="true"
    >
    </div>
    <Header />
    <slot />
    <Footer />
    <style is:global>
      :root {
        color-scheme: light;
      }

      html {
        font-family: "Onest Variable", system-ui, sans-serif;
        scroll-behavior: smooth;
      }

      body {
        color: rgba(17, 17, 17, 0.9);
        display: flex;
        flex-direction: column;
        min-height: 100vh;
        overscroll-behavior: none;
      }

      @media (prefers-reduced-motion: reduce) {
        html {
          scroll-behavior: auto;
        }
      }

      @keyframes blur {
        to {
          backdrop-filter: blur(20px);
          border-width: 1px;
          border-color: rgba(0, 0, 0);
          padding: 0.25rem 0.75rem;
          display: flex;
          flex-direction: row;
          align-items: center;
          background-color: rgb(229, 229, 229);
          border-radius: 9999px;
        }
      }

      @keyframes fade-in-up {
        from {
          opacity: 0;
          translate: 0 20px;
        }
        to {
          opacity: 1;
          translate: 0 0;
        }
      }

      .anim-fade-in {
        animation: fade-in-up 0.65s cubic-bezier(0.22, 1, 0.36, 1) both;
      }
      .anim-delay-1 {
        animation-delay: 120ms;
      }
      .anim-delay-2 {
        animation-delay: 260ms;
      }
      .anim-delay-3 {
        animation-delay: 400ms;
      }
      .anim-delay-4 {
        animation-delay: 540ms;
      }


      @supports (animation-timeline: view()) {
        [data-section] {
          animation: fade-in-up 0.7s cubic-bezier(0.22, 1, 0.36, 1) both;
          animation-timeline: view();
          animation-range: entry 0% entry 18%;
        }
      }

      @media (prefers-reduced-motion: reduce) {
        .anim-fade-in,
        [data-section] {
          animation: none !important;
          opacity: 1 !important;
          translate: none !important;
        }
      }
    </style>
  </body>
</html>
